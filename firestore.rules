rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user must be provisioned by a trusted administrator
    // with a custom claim: { substationIds: ["substation_132_33kv_main"] }.
    // Never let clients write their own custom claims or membership records.
    match /gridops_substations/{substationId} {
      function canAccessSubstation() {
        return request.auth != null
          && request.auth.token.substationIds is list
          && request.auth.token.substationIds.hasAny([substationId]);
      }
      allow get, list: if canAccessSubstation();
      allow create, update: if canAccessSubstation()
        && request.resource.data.substationName is string
        && request.resource.data.ptrs is list
        && request.resource.data.relays is list
        && request.resource.data.faults is list
        && request.resource.data.feeders is list;
      allow delete: if false;
    }
    // All other collections and documents are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
